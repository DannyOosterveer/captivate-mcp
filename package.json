    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannyOosterveer/captivate-mcp.git"
  },
  "homepage": "https://github.com/DannyOosterveer/captivate-mcp#readme",
  "author": "Danny Oosterveer"
